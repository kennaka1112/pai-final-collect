#!/bin/bash
# コンテナからGPUが見えるか確認
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv 2>/dev/null || echo "nvidia-smi: 見つかりません"
cd ~/pai_training && pixi run python -c \
  "import torch; print('torch', torch.__version__, '| CUDA available:', torch.cuda.is_available(), '|', torch.cuda.get_device_name(0) if torch.cuda.is_available() else '-')"
